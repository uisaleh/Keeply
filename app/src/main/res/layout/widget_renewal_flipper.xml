<?xml version="1.0" encoding="utf-8"?>
<!-- Cycles through the next renewals every 3.5 s while the widget is on screen (filled in code). -->
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_renewal_flipper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:autoStart="true"
    android:flipInterval="3500"
    android:inAnimation="@anim/widget_slide_in_up"
    android:outAnimation="@anim/widget_slide_out_up" />
