<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: monthly subscription spend and the next renewal. 4x2 by default, resizable down to one row. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_spend_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="48dp"
    android:previewLayout="@layout/widget_spend_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="21600000"
    android:widgetCategory="home_screen" />
