<?xml version="1.0" encoding="utf-8"?>
<!-- https only, and only the phone's built-in certificate authorities: a certificate a user or
     another app installed can't be used to read Keeply's traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
