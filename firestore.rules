rules_version = '2';

// Each user can only read and write their own vault: users/{uid}/items/{itemId} and users/{uid}/events/{eventId}.
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      match /items/{itemId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['type', 'updatedAt', 'data'])
          && request.resource.data.type is string
          && request.resource.data.updatedAt is int
          && request.resource.data.data is string
          && request.resource.data.data.size() < 500000;
      }

      // Activity history: entries can't be edited; the owner can delete them (from Activity, "Delete all data" or deleting the account).
      match /events/{eventId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['itemId', 'type', 'title', 'kind', 'at'])
          && request.resource.data.itemId is string
          && request.resource.data.type is string
          && request.resource.data.title is string && request.resource.data.title.size() < 1000
          && request.resource.data.kind in ['ADDED', 'EDITED', 'CANCELLED', 'DELETED', 'REMINDED', 'DONE', 'PAID', 'UNDONE']
          && request.resource.data.at is int;
        // Re-sending an entry that's already there (a retry) is allowed but can't change it.
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data == resource.data;
      }
    }
    // Everything else is closed.
  }
}
